# Generate a strong value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=replace-with-a-long-random-secret
APP_ENV=production

# JSON object: email address -> Werkzeug password hash.
# Generate a hash with: python create_user.py boss@example.com
APP_USERS_JSON={"user@example.com":"paste-generated-password-hash-here"}
